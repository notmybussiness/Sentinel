{
  "server_status": {
    "port": 8080,
    "profile": "dev",
    "health_endpoint": "http://localhost:8080/api/health",
    "swagger_ui": "http://localhost:8080/swagger-ui/index.html"
  },
  "authentication": {
    "oauth": {
      "provider": "kakao",
      "login_url_endpoint": "GET /api/v1/auth/kakao",
      "callback_endpoint": "GET /api/v1/auth/kakao/callback",
      "callback_params": "?code={authorization_code}",
      "response_format": {
        "accessToken": "string (JWT)",
        "refreshToken": "string",
        "expiresIn": "number (milliseconds)",
        "user": {
          "id": "number",
          "kakaoId": "string",
          "nickname": "string",
          "email": "string",
          "profileImage": "string",
          "createdAt": "datetime"
        }
      }
    },
    "token_management": {
      "refresh": "POST /api/v1/auth/refresh",
      "logout": "POST /api/v1/auth/logout",
      "current_user": "GET /api/v1/auth/me"
    },
    "authorization": {
      "header": "Authorization: Bearer {token}",
      "required_for": ["portfolios", "holdings", "rebalancing"]
    }
  },
  "portfolios": {
    "base_path": "/api/v1/portfolios",
    "endpoints": {
      "list": "GET /api/v1/portfolios",
      "get": "GET /api/v1/portfolios/{id}",
      "create": "POST /api/v1/portfolios",
      "update": "PUT /api/v1/portfolios/{id}",
      "delete": "DELETE /api/v1/portfolios/{id}",
      "recalculate": "POST /api/v1/portfolios/{id}/recalculate"
    },
    "portfolio_dto": {
      "id": "number",
      "userId": "number",
      "name": "string",
      "description": "string",
      "totalValue": "BigDecimal",
      "totalCost": "BigDecimal",
      "totalGainLoss": "BigDecimal",
      "totalGainLossPercent": "BigDecimal",
      "createdAt": "datetime",
      "updatedAt": "datetime",
      "holdings": "PortfolioHoldingDto[]"
    }
  },
  "holdings": {
    "base_path": "/api/v1/portfolios/{portfolioId}/holdings",
    "endpoints": {
      "add": "POST /api/v1/portfolios/{portfolioId}/holdings",
      "update": "PUT /api/v1/portfolios/{portfolioId}/holdings/{holdingId}",
      "delete": "DELETE /api/v1/portfolios/{portfolioId}/holdings/{holdingId}"
    },
    "holding_dto": {
      "id": "number",
      "portfolioId": "number",
      "symbol": "string",
      "quantity": "BigDecimal",
      "averageCost": "BigDecimal",
      "currentPrice": "BigDecimal",
      "marketValue": "BigDecimal",
      "totalCost": "BigDecimal",
      "gainLoss": "BigDecimal",
      "gainLossPercent": "BigDecimal",
      "createdAt": "datetime",
      "updatedAt": "datetime"
    }
  },
  "market_data": {
    "base_path": "/api/v1/market",
    "endpoints": {
      "single_stock": "GET /api/v1/market/price/{symbol}",
      "multiple_stocks": "GET /api/v1/market/prices?symbols=AAPL,GOOGL",
      "service_status": "GET /api/v1/market/status"
    },
    "stock_price_dto": {
      "symbol": "string",
      "price": "double",
      "open": "double",
      "high": "double",
      "low": "double",
      "close": "double",
      "change": "double",
      "changePercent": "double",
      "lastTradingDay": "string",
      "timeStamp": "datetime",
      "provider": "string (alphavantage|finnhub|yahoo)"
    }
  },
  "rebalancing": {
    "base_path": "/api/v1/portfolios/{portfolioId}/rebalancing",
    "endpoints": {
      "recommendation": "POST /api/v1/portfolios/{portfolioId}/rebalancing/recommendation",
      "check_need": "POST /api/v1/portfolios/{portfolioId}/rebalancing/check",
      "quick_analysis": "POST /api/v1/portfolios/{portfolioId}/rebalancing/quick-analysis",
      "recommended_strategy": "GET /api/v1/portfolios/{portfolioId}/rebalancing/strategy/recommendation",
      "all_strategies": "GET /api/v1/portfolios/{portfolioId}/rebalancing/strategies"
    },
    "available_strategies": ["CALENDAR", "THRESHOLD", "HYBRID"],
    "recommendation_params": {
      "strategy": "string (CALENDAR|THRESHOLD|HYBRID)",
      "targetAllocations": "Map<String, Double>"
    }
  },
  "development": {
    "base_path": "/api/dev",
    "endpoints": {
      "generate_token": "GET /api/dev/token?userId=1",
      "verify_token": "GET /api/dev/verify?token={jwt}"
    },
    "profile": "dev only",
    "purpose": "테스트용 JWT 토큰 생성/검증"
  },
  "system": {
    "endpoints": {
      "health": "GET /api/health",
      "rebalancing_health": "GET /api/v1/system/health/rebalancing"
    }
  },
  "cors_settings": {
    "enabled": true,
    "allowed_origins": ["http://localhost:3000", "http://localhost:3001"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowed_headers": ["*"],
    "allow_credentials": true
  },
  "external_apis": {
    "alphavantage": {
      "enabled": true,
      "rate_limit": "5 calls/minute",
      "api_key_required": true
    },
    "finnhub": {
      "enabled": true,
      "rate_limit": "60 calls/minute",
      "api_key_required": true
    },
    "yahoo_finance": {
      "enabled": true,
      "rate_limit": "unlimited",
      "api_key_required": false
    }
  },
  "notes": {
    "frontend_integration": [
      "모든 포트폴리오/홀딩 API는 JWT 인증 필요",
      "Kakao OAuth 콜백은 FE에서 code를 받아서 BE로 전달",
      "시장 데이터는 인증 없이 접근 가능",
      "개발용 토큰은 /api/dev/token으로 생성 가능",
      "CORS는 localhost:3000, 3001로 설정됨"
    ],
    "missing_endpoints": [
      "자산 검색 API (심볼/회사명으로 검색)",
      "인기 포트폴리오 조회",
      "시장 인덱스 데이터 (S&P 500, NASDAQ 등)"
    ]
  }
}