  "usage": {
    "description": "이 테마 데이터를 Next.js + Tailwind CSS 프로젝트에서 사용하는 방법",
    "tailwindConfig": {
      "colors": "theme.colors를 tailwind.config.js의 colors에 매핑",
      "fontSize": "theme.typography.fontSize를 fontSize에 매핑",
      "fontFamily": "theme.typography.fontFamily를 fontFamily에 매핑",
      "borderRadius": "theme.borderRadius를 borderRadius에 매핑",
      "boxShadow": "theme.shadows를 boxShadow에 매핑"
